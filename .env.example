# ==========================================
# MAHIRU — API CONFIGURATION
# Copy this file to .env, then replace the values.
# Keep real keys private; never commit .env.
# ==========================================

# Web Research APIs
# Tavily endpoint: https://api.tavily.com/search
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
# Brave Search endpoint: https://api.search.brave.com/res/v1/web/search
BRAVE_API_KEY=YOUR_BRAVE_SEARCH_API_KEY

# Database / Cloud Memory (Supabase REST + pgvector)
# Project URL format: https://YOUR_PROJECT_ID.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Telegram Bot API
# Create/manage bot token via @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
BACKUP_TG_BOT_TOKEN=YOUR_BACKUP_TELEGRAM_BOT_TOKEN
BACKUP_TG_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Media Downloader APIs (legacy-compatible defaults)
KNIGHT_API_URL=https://knightbotapi.stream
KNIGHT_API_KEY=knight
MEDIA_API_URL=https://knightbotapi.stream
MEDIA_API_KEY=knight
PRINCE_API_URL=https://api.princetechn.com
PRINCE_API_KEY=prince
VIDFETCH_API_KEY=YOUR_VIDFETCH_API_KEY
# Mahiru YouTube search/details/formats API
MAHIRU_AI_API_URL=https://mahiru-shiina-ai.vercel.app

# GIF / Sticker media APIs
GIPHY_API_KEY=YOUR_GIPHY_API_KEY
TENOR_API_KEY=YOUR_TENOR_API_KEY

# AI provider keys (optional; configure at least one provider)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_API_KEY_2=
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_API_KEY_2=
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Optional neural voice cloning
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
